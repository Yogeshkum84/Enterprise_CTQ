# YK CTQ Audit Intelligence Platform - Configuration
# Copy this file to .env and update with your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-use-secrets.token_hex-32-to-generate

# Server Configuration
HOST=127.0.0.1
PORT=8745

# Database
DATABASE_PATH=data/ctq_history.db
LOG_DIR=Logs

# User Credentials (bcrypt hashes - see README for setup instructions)
# For production: set `ADMIN_PASSWORD_HASH` and `USER_PASSWORD_HASH` to bcrypt hashes.
# Do NOT store real passwords here. To generate a bcrypt hash:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt()).decode())"
# For safety this example leaves values blank — the server will refuse login unless hashes are provided
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
USER_USERNAME=user
USER_PASSWORD_HASH=

# Session Configuration
SESSION_TIMEOUT_MINUTES=480
PERMANENT_SESSION_LIFETIME=28800

# CORS Configuration (comma-separated, or use * for development only)
CORS_ALLOWED_ORIGINS=http://localhost:8745

# Email Notifications (Optional)
# Leave these blank to disable email notifications
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@ctq-enterprise.local
# Comma-separated list of emails to notify on batch completion
MAIL_NOTIFICATION_RECIPIENTS=admin@company.com,qa-lead@company.com

# Optional Features
ENABLE_SKLEARN=true
SKLEARN_CLUSTERING_ENABLED=true

# Development safety switch: when true and FLASK_ENV=development, the server will
# seed a default admin account to simplify local testing. Do NOT enable in prod.
# Enforced: the server refuses to start with this on if HOST is not loopback
# (127.0.0.1/localhost), so it cannot accidentally expose the default credential.
ALLOW_DEV_DEFAULTS=false

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
